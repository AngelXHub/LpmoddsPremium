                mouse1click()
            elseif type(mouse1press) == "function" and type(mouse1release) == "function" then
                mouse1press()
                task.wait(0.02)
                mouse1release()
            elseif type(keypress) == "function" and type(keyrelease) == "function" then
                keypress(0x01)
                task.wait(0.02)
                keyrelease(0x01)
            end
        end)
    end

    local FOVCircle = Drawing.new("Circle")
