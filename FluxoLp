local function AddCustomBackground(assetId)
    local screenGui = nil
    for _, gui in pairs(game.CoreGui:GetChildren()) do
        if gui:IsA("ScreenGui") and (gui.Name:lower():find("redz") or gui.Name:lower():find("library")) then
            screenGui = gui; break
        end
    end
    if not screenGui then return end
    local mainFrame = nil
    for _, desc in pairs(screenGui:GetDescendants()) do
        if desc:IsA("ImageButton") and desc.Name:lower():find("hub") then mainFrame = desc; break
        elseif desc:IsA("Frame") and desc.Name:lower():find("main") then mainFrame = desc; break end
    end
    if not mainFrame then return end
    local old = mainFrame:FindFirstChild("CustomBackground")
    if old then old:Destroy() end
    local bg = Instance.new("ImageLabel")
    bg.Name = "CustomBackground"
    bg.Size = UDim2.new(1,0,1,0); bg.Position = UDim2.new(0,0,0,0)
    bg.BackgroundTransparency = 1
    bg.Image = assetId
    bg.ImageTransparency = 0.35
    bg.ScaleType = Enum.ScaleType.Crop
    bg.ZIndex = 0
    bg.Parent = mainFrame
end

