    local function HasLOS(part)
        if not part then return false end
        local char = LocalPlayer.Character
        local origin = workspace.CurrentCamera.CFrame.Position
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char, part.Parent }
        local r = workspace:Raycast(origin, part.Position - origin, params)
        return r == nil
    end

    local CurrentTarget
    local function GetTarget()
        local cam = workspace.CurrentCamera
        if not cam then return nil end

        if CurrentTarget and CurrentTarget.Character then
            local h = CurrentTarget.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then return CurrentTarget end
        end
        CurrentTarget = nil

        local closest, shortest = nil, Settings.FOVSize
        local mouse = Services.UserInputService:GetMouseLocation()
        local char = LocalPlayer.Character

        for _, p in ipairs(Services.Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    if Settings.TeamCheck and IsAlly(p) then continue end
                    local part = p.Character:FindFirstChild(Settings.AimPart)
                    if part then
                        if Settings.WallCheck and char and not HasLOS(part) then continue end
                        local sp, on = cam:WorldToViewportPoint(part.Position)
                        if on then
                            local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                            if d < shortest then
                                shortest = d
                                closest = p
                            end
                        end
                    end
                end
            end
        end
        CurrentTarget = closest
        return closest
    end

    local function GetSilentTarget()
        local cam = workspace.CurrentCamera
        if not cam then return nil end
        local closest, shortest = nil, Settings.SilentRange
        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

        for _, p in ipairs(Services.Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    if Settings.TeamCheck and IsAlly(p) then continue end
                    local part = p.Character:FindFirstChild(Settings.SilentHitPart)
                    if part then
                        if Settings.WallCheck and not HasLOS(part) then continue end
                        local sp, on = cam:WorldToViewportPoint(part.Position)
                        if on then
                            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if d < shortest then
                                shortest = d
                                closest = p
                            end
                        end
                    end
                end
            end
        end
        return closest
    end

    local function fireWeapon()
        pcall(function()
