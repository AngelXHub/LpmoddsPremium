    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if isPremium and Settings.Silent and method == "FireServer" and self:IsA("RemoteEvent") then
            local target = GetSilentTarget()
            if target and target.Character then
                local part = target.Character:FindFirstChild(Settings.SilentHitPart)
                if part then
                    if math.random(1, 100) > Settings.SilentChance then return oldNamecall(self, ...) end
                    local aimPos = part.Position
                    if Settings.Prediction then
                        local hrp = target.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then aimPos = aimPos + hrp.AssemblyLinearVelocity * Settings.PredictionAmount end
                    end
                    local args = {...}
                    local changed = false
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = aimPos
                            changed = true
                        elseif typeof(v) == "CFrame" then
                            args[i] = CFrame.lookAt(v.Position, aimPos)
                            changed = true
                        end
                    end
                    if changed then
                        return oldNamecall(self, table.unpack(args))
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)

    Services.RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        FOVCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        FOVCircle.Radius = Settings.FOVSize
        FOVCircle.Visible = Settings.ShowFOV

        if Settings.Aimbot and not (isPremium and Settings.Aimkill) then
            local t = GetTarget()
            if t and t.Character then
                local part = t.Character:FindFirstChild(Settings.AimPart)
                if part then
                    local aimPos = part.Position
                    if Settings.Prediction then
                        local hrp = t.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then aimPos = aimPos + hrp.AssemblyLinearVelocity * Settings.PredictionAmount end
                    end
                    cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, aimPos), 1 - Settings.Smoothness)
                end
            end
        end

        if isPremium and Settings.Aimkill then
            local t = GetTarget()
            if t and t.Character then
                local h = t.Character:FindFirstChildOfClass("Humanoid")
                local part = t.Character:FindFirstChild(Settings.AimPart)
                if h and h.Health > 0 and part then
                    local aimPos = part.Position
                    if Settings.Prediction then
                        local hrp = t.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then aimPos = aimPos + hrp.AssemblyLinearVelocity * Settings.PredictionAmount end
                    end
                    cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, aimPos), 1)

                    if tick() - lastShot >= Settings.AimkillDelay then
                        lastShot = tick()
                        fireWeapon()
                    end

                    if aimkillTarget ~= t then
                        aimkillTarget = t
                        aimkillStart = tick()
                    end

                    if Settings.AimkillAutoStop and (tick() - aimkillStart) >= Settings.AimkillKillTime then
                        aimkillTarget = nil
                        task.wait(0.5)
                    end
                else
                    aimkillTarget = nil
                end
            else
                aimkillTarget = nil
            end
        end
    end)

