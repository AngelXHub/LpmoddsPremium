    local function GetClosestPlayer(modo)
        local Target, TargetPart = nil, nil
        local isSilent = (modo == "silent")
        local MaxDistance = isSilent and Settings.SilentFOV or Settings.FOVSize
        local CenterScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local usarFOV = not isSilent or Settings.SilentUseFOV

        for _, player in pairs(Services.Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local head = char:FindFirstChild("Head")
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                local rootPart = char:FindFirstChild("HumanoidRootPart")
                local checkTeam = isSilent and Settings.SilentTeamCheck or (not isSilent and Settings.TeamCheck)
                local checkWall = isSilent and Settings.SilentWallCheck or (not isSilent and Settings.WallCheck)

                if head and humanoid and rootPart then
                    if checkTeam and IsAlly(player) then continue end
                    if Settings.IgnoreDead then
                        if humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead or not char:IsDescendantOf(workspace) then continue end
                    else
                        if humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead then continue end
                    end
                    local aimPart = isSilent and (char:FindFirstChild(Settings.SilentHitPart) or head) or head
                    if checkWall and not HasLineOfSight(aimPart) then continue end
                    local headPos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
                    if onScreen or not usarFOV then
                        local distance = onScreen and (Vector2.new(headPos.X, headPos.Y) - CenterScreen).Magnitude or 0
                        if distance <= MaxDistance then
                            MaxDistance = distance
                            Target = player
                            TargetPart = aimPart
                        end
                    end
                end
            end
        end
        return Target, TargetPart
    end

    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if isPremium and Settings.Silent and (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "Raycast") then
            local args = {...}
            local ray = args[1]
            local comprimento = 0
            if typeof(ray) == "Ray" then comprimento = ray.Direction.Magnitude
            elseif typeof(ray) == "Vector3" then comprimento = ray.Magnitude end
            if comprimento > 0 and comprimento < 30 then return oldNamecall(self, ...) end

            local myChar = LocalPlayer.Character
            if myChar and typeof(ray) == "Ray" then
                local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                if myHRP and (ray.Origin - myHRP.Position).Magnitude < 3 then
                    return oldNamecall(self, ...)
                end
            end

            if typeof(ray) == "Ray" and ray.Direction.Unit.Y < -0.7 then
                return oldNamecall(self, ...)
            end

            local target, targetPart = GetClosestPlayer("silent")
            if target and targetPart then
                if math.random(1, 100) > Settings.SilentHitChance then return oldNamecall(self, ...) end
                local dest = targetPart.Position
                if Settings.SilentRandomize then
                    dest = dest + Vector3.new(math.random(-50,50)/100, math.random(-50,50)/100, math.random(-50,50)/100)
                end
                if method == "Raycast" then
                    args[2] = dest
                else
                    if typeof(ray) == "Ray" then
                        local dir = (dest - ray.Origin).Unit * (ray.Direction.Magnitude > 0 and ray.Direction.Magnitude or Settings.SilentRange)
                        args[1] = Ray.new(ray.Origin, dir)
                    end
                end
                return oldNamecall(self, table.unpack(args))
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)

