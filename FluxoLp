    local function ApplyHitbox(p)
        local char = p.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not hrp then return end
        if not OriginalHitbox[p] then
            OriginalHitbox[p] = {
                hrpSize = hrp.Size, hrpTrans = hrp.Transparency, hrpColl = hrp.CanCollide,
                headSize = head and head.Size, headTrans = head and head.Transparency
            }
        end
        local o = OriginalHitbox[p]
        local m = Settings.HitboxSize
        local tr = Settings.HitboxVisible and Settings.HitboxTransparency or 1
        hrp.Size = o.hrpSize * m
        hrp.Transparency = tr
        hrp.CanCollide = false
        if head and o.headSize then
            head.Size = o.headSize * m
            head.Transparency = tr
            head.CanCollide = false
        end
    end

    local function RestoreHitbox(p)
        local char = p.Character
        local o = OriginalHitbox[p]
        if not char or not o then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if hrp then
            hrp.Size = o.hrpSize; hrp.Transparency = o.hrpTrans; hrp.CanCollide = o.hrpColl
        end
        if head and o.headSize then
            head.Size = o.headSize; head.Transparency = o.headTrans
        end
        OriginalHitbox[p] = nil
    end

    local function RestoreAll()
        for p, _ in pairs(OriginalHitbox) do RestoreHitbox(p) end
        OriginalHitbox = {}
    end

