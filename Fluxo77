local function ehChat(nome)
    local n = nome:lower()
    return n:find("chat") or n:find("bubble") or n:find("textchat")
end

local function definirVisibilidadeExecutor(visivel)
    local executorGui = gethui and gethui() or game.CoreGui
    if not executorGui then return end
    if visivel then
        for _, gui in pairs(guisEscondidos) do
            pcall(function() gui.Enabled = true end)
        end
        guisEscondidos = {}
    else
        guisEscondidos = {}
        for _, item in pairs(executorGui:GetChildren()) do
            if item:IsA("ScreenGui") and not ehChat(item.Name) then
                if item.Enabled then item.Enabled = false; table.insert(guisEscondidos, item) end
            end
        end
        for _, item in pairs(game.CoreGui:GetChildren()) do
            if item:IsA("ScreenGui") and not item.Name:find("Fluent") and not ehChat(item.Name) then
                if item.Enabled then item.Enabled = false; table.insert(guisEscondidos, item) end
            end
        end
    end
end

local function AlternarExecutor()
    executorEscondido = not executorEscondido
    definirVisibilidadeExecutor(not executorEscondido)
end

local function checarGravadoresMobile()
    if type(getrunningprocesses) == "function" then
        local ok, procs = pcall(getrunningprocesses)
        if ok and type(procs) == "table" then
            for _, proc in pairs(procs) do
                local n = tostring(proc):lower()
                if n:find("recorder") or n:find("capture") or n:find("obs") then return true end
            end
        end
    end
    return false
end

local function IsAlly(player)
    if not player or not player.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function HasLineOfSight(targetPart)
    if not targetPart then return false end
    local myChar = LocalPlayer.Character
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { myChar, targetPart.Parent }
    local result = workspace:Raycast(origin, targetPart.Position - origin, params)
    return result == nil
end

local function ApplySpeed()
