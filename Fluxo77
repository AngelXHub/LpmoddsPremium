local function ehChat(nome)
    local n = nome:lower()
    return n:find("chat") or n:find("bubble") or n:find("textchat")
        or n:find("topbar") or n:find("topbarplus")
end

local function definirVisibilidadeExecutor(visivel)
    local executorGui = gethui and gethui() or game.CoreGui
    if not executorGui then return end
    if visivel then
        for _, gui in pairs(guisEscondidos) do
            pcall(function() gui.Enabled = true end)
        end
        guisEscondidos = {}
    else
        guisEscondidos = {}
        for _, item in pairs(executorGui:GetChildren()) do
            if item:IsA("ScreenGui") and not ehChat(item.Name) then
                if item.Enabled then item.Enabled = false; table.insert(guisEscondidos, item) end
            end
        end
        for _, item in pairs(game.CoreGui:GetChildren()) do
            if item:IsA("ScreenGui")
                and item.Name ~= "LpModsFloatingButtonGui"
                and item.Name ~= "LpModsTopBanner"
                and item.Name ~= "LpModsGhostBtn"
                and not item.Name:find("Fluent")
                and not ehChat(item.Name) then
                if item.Enabled then item.Enabled = false; table.insert(guisEscondidos, item) end
            end
        end
    end
end

local function AlternarExecutor()
    executorEscondido = not executorEscondido
