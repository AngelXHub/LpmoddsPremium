local function CreateESP(player)
    if ESPDrawings[player] then return end
    local d = { Box = Drawing.new("Square"), Line = Drawing.new("Line"), Name = Drawing.new("Text") }
    d.Box.Color = CyanColor; d.Box.Thickness = 1.5; d.Box.Filled = false
    d.Line.Color = CyanColor; d.Line.Thickness = 1
    d.Name.Color = CyanColor; d.Name.Size = 13; d.Name.Center = true; d.Name.Outline = true
    ESPDrawings[player] = d
end

Services.RunService.RenderStepped:Connect(function()
    local CenterScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Position = CenterScreen
    FOVCircle.Radius = Settings.ShowFOV and Settings.FOVSize or (Settings.SilentUseFOV and Settings.Silent and Settings.SilentFOV or Settings.FOVSize)
    FOVCircle.Visible = Settings.ShowFOV or (Settings.SilentUseFOV and Settings.Silent)

    if Settings.FOVRainbow then
        FOVCircle.Color = Color3.fromHSV((tick() * Settings.FOVRainbowSpeed) % 1, 1, 1)
    else
        FOVCircle.Color = Settings.FOVColor
    end

    if Settings.Aimbot then
        local target = GetClosestPlayer(false)
        if target and target.Character then
            local head = target.Character:FindFirstChild("Head")
            local hum = target.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 and not Settings.Silent then
                if Settings.LegitMode then
                    local current = Camera.CFrame
                    local goal = CFrame.new(current.Position, head.Position)
                    Camera.CFrame = current:Lerp(goal, math.clamp(Settings.Smoothing, 0.01, 1))
                else
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
                end
            end
        end
    end

    if Settings.AutoShot and Settings.Silent then
        local target = GetClosestPlayer(true)
        if target or not Settings.AutoShotRequireTarget then
            if tick() - AutoShotCooldown >= Settings.AutoShotDelay then
                AutoShotCooldown = tick()
                pcall(function()
                    if type(mouse1click) == "function" then mouse1click()
                    elseif type(keypress) == "function" and type(keyrelease) == "function" then
                        keypress(0x01); task.delay(0.02, function() keyrelease(0x01) end)
                    end
                end)
            end
        end
    end

    if Settings.Spinbot and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(150), 0)
    end

    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not ESPDrawings[player] then CreateESP(player) end
            local d = ESPDrawings[player]
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local ally = IsAlly(player)
            local shouldRender = ally and Settings.ESP_Ally or (not ally and Settings.ESP_Master)

            if shouldRender and char and hum and hum.Health > 0 then
                local cframe, size = char:GetBoundingBox()
                local screenPos, onScreen = Camera:WorldToViewportPoint(cframe.Position)
                if onScreen then
                    local rc = ally and Settings.AllyColor or CyanColor
                    d.Box.Color = rc; d.Line.Color = rc; d.Name.Color = rc
                    local topW = cframe.Position + Vector3.new(0, size.Y/2, 0)
                    local botW = cframe.Position - Vector3.new(0, size.Y/2, 0)
                    local topS = Camera:WorldToViewportPoint(topW)
                    local botS = Camera:WorldToViewportPoint(botW)
                    local h = math.abs(topS.Y - botS.Y)
                    local w = h / 1.6

                    if Settings.ESP_Boxes then
                        d.Box.Size = Vector2.new(w, h)
                        d.Box.Position = Vector2.new(screenPos.X - w/2, topS.Y)
                        d.Box.Visible = true
                    else d.Box.Visible = false end

                    if Settings.ESP_Lines then
                        d.Line.From = Vector2.new(Camera.ViewportSize.X/2, 0)
                        d.Line.To = Vector2.new(screenPos.X, topS.Y)
                        d.Line.Visible = true
                    else d.Line.Visible = false end

                    if Settings.ESP_Names then
                        d.Name.Text = player.Name .. (ally and " [ALLY]" or "")
                        d.Name.Position = Vector2.new(screenPos.X, topS.Y - 16)
                        d.Name.Visible = true
                    else d.Name.Visible = false end

                    if Settings.ESP_Player then
                        local hl = char:FindFirstChild("LpModsChams")
                        if not hl then
                            hl = Instance.new("Highlight")
                            hl.Name = "LpModsChams"
                            hl.FillTransparency = 0.5
                            hl.OutlineTransparency = 0
                            hl.Parent = char
                        end
                        hl.FillColor = rc; hl.OutlineColor = rc; hl.Enabled = true
                    else
                        if char:FindFirstChild("LpModsChams") then char.LpModsChams.Enabled = false end
                    end
                else
                    d.Box.Visible = false; d.Line.Visible = false; d.Name.Visible = false
                    if char:FindFirstChild("LpModsChams") then char.LpModsChams.Enabled = false end
                end
            else
                d.Box.Visible = false; d.Line.Visible = false; d.Name.Visible = false
                if char and char:FindFirstChild("LpModsChams") then char.LpModsChams.Enabled = false end
            end
        end
    end
end)

