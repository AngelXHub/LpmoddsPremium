local function GetClosestPlayer(forSilent)
    local Target, TargetPart = nil, nil
    local MaxDistance = forSilent and Settings.SilentFOV or Settings.FOVSize
    local CenterScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local usarFOV = not forSilent or Settings.SilentUseFOV

    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            local checkTeam = forSilent and Settings.SilentTeamCheck or (not forSilent and Settings.TeamCheck)
            local checkWall = forSilent and Settings.SilentWallCheck or (not forSilent and Settings.WallCheck)

            if head and hum and root then
                if checkTeam and IsAlly(player) then continue end
                if Settings.IgnoreDead then
                    if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead or not char:IsDescendantOf(workspace) then continue end
                else
                    if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then continue end
                end
                local aimPart = forSilent and (char:FindFirstChild(Settings.SilentHitPart) or head) or head
                if checkWall and not HasLineOfSight(aimPart) then continue end
                local headPos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
                if onScreen or not usarFOV then
                    local distance = onScreen and (Vector2.new(headPos.X, headPos.Y) - CenterScreen).Magnitude or 0
                    if distance <= MaxDistance then
                        MaxDistance = distance
                        Target = player
                        TargetPart = aimPart
                    end
                end
            end
        end
    end
    return Target, TargetPart
end

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if Settings.Silent and (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "Raycast") then
        local target, targetPart = GetClosestPlayer(true)
        if target and targetPart then
            if math.random(1, 100) > Settings.SilentHitChance then return oldNamecall(self, ...) end
            local dest = targetPart.Position
            if Settings.SilentRandomize then
                dest = dest + Vector3.new(math.random(-50,50)/100, math.random(-50,50)/100, math.random(-50,50)/100)
            end
            local args = {...}
            if method == "Raycast" then
                args[2] = targetPart
            else
                local ray = args[1]
                if typeof(ray) == "Ray" then
                    local dir = (dest - ray.Origin).Unit * (ray.Direction.Magnitude > 0 and ray.Direction.Magnitude or 1000)
                    args[1] = Ray.new(ray.Origin, dir)
                end
            end
            return oldNamecall(self, table.unpack(args))
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

