end)

local function ApplyHitbox(player)
    local char = player.Character
    if not char then return end
    if not OriginalHitbox[player] then OriginalHitbox[player] = {} end
    local orig = OriginalHitbox[player]
    local mult = Settings.HitboxSize

    for _, partName in pairs({"Head","HumanoidRootPart","UpperTorso","LowerTorso","LeftArm","RightArm","LeftHand","RightHand","LeftLeg","RightLeg","LeftFoot","RightFoot"}) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            if not orig[partName] then
                orig[partName] = { Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide }
            end
            if Settings.HitboxParts[partName] then
                local o = orig[partName]
                part.Size = Vector3.new(o.Size.X * mult, o.Size.Y * mult, o.Size.Z * mult)
                part.Transparency = Settings.HitboxVisible and 0.5 or 1
                part.CanCollide = false
            end
        end
    end
end

local function RestoreHitbox(player)
    local char = player.Character
    local orig = OriginalHitbox[player]
    if not char or not orig then return end
    for partName, o in pairs(orig) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            part.Size = o.Size
            part.Transparency = o.Transparency
            part.CanCollide = o.CanCollide
        end
    end
    OriginalHitbox[player] = nil
end

local function RestoreAllHitboxes()
    for player, _ in pairs(OriginalHitbox) do RestoreHitbox(player) end
    OriginalHitbox = {}
end

Services.RunService.Heartbeat:Connect(function()
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if Settings.HitboxEnabled then
                ApplyHitbox(player)
            elseif OriginalHitbox[player] then
